@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(NOT TARGET unilidar::sdk2)
  if(NOT UNILIDAR_SDK_ARCH)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
      set(UNILIDAR_SDK_ARCH "x86_64")
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
      set(UNILIDAR_SDK_ARCH "aarch64")
    else()
      message(FATAL_ERROR
        "unilidar_sdk2 provides x86_64 and aarch64 archives only; the consuming "
        "toolchain reports '${CMAKE_SYSTEM_PROCESSOR}'.")
    endif()
  endif()

  set_and_check(
    UNILIDAR_SDK_INCLUDE_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/unilidar_sdk2")
  set_and_check(
    UNILIDAR_SDK_LIBRARY
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/unilidar_sdk2/${UNILIDAR_SDK_ARCH}/libunilidar_sdk2.a")

  add_library(unilidar::sdk2 STATIC IMPORTED)
  set_target_properties(unilidar::sdk2 PROPERTIES
    IMPORTED_LOCATION "${UNILIDAR_SDK_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${UNILIDAR_SDK_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "Threads::Threads"
  )
endif()

check_required_components(unilidar_sdk2)
